<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ 系统 Splash 启动页 -->
    <style name="Theme.QMusic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/qmusic_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">#FF4B5C</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>